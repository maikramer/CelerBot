# CelerBot: firmware do ESP32-S3 DevKitC-1 (BT + console na USB nativa).
#
# O devkit-s3 nasce como "laboratorio de USB host": o sdkconfig.defaults da
# placa liga o host OTG em GPIO19/20 e deixa o BT desligado de proposito. O
# CelerBot nao usa host USB — precisa do Celer Link (BLE) e do celerctl/logcat.
# Este fragmento troca o host pelo console/celerctl na USB-Serial/JTAG nativa
# (a MESMA USB-C que grava) e liga o NimBLE.
#
# No ESP32-S3 o OTG e a USJ dividem o PHY interno: CELEROS_LINK_ON_USJ e
# CELEROS_USB_HOST sao exclusivos no Kconfig. Com a USJ, um cabo so resolve
# flash, console e celerctl; o USB-C rotulado UART (CP2102N) fica opcional.
#
# Uso (o tools/build-firmware.sh faz isso):
#   idf.py -B build-celerbot -DSDKCONFIG=build-celerbot/sdkconfig \
#     -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;boards/devkit-s3/sdkconfig.defaults;<este arquivo>" \
#     -DCELEROS_BOARD=devkit-s3 set-target esp32s3
#
# NimBLE enxuto via C API do IDF: 1 conexao, os 4 papeis (o Celer Remote e
# central; o robo e peripheral, mas o Celer Link inicializa os quatro) e MTU
# 256 para as mensagens do app. Os pools/buffers do HOST vao para a PSRAM:
# com tudo na RAM interna o ble_hs_init caia num SYSINIT_PANIC_ASSERT no
# primeiro scan (medido na SmartDisplay: ~38 KB internos depois do ajuste).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
# CONFIG_BT_NIMBLE_NVS_PERSIST is not set
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# O Celer Link dos apps (CelerLink.*): liga o objeto global. Depende dos
# dois simbolos acima; explicito para o build falhar alto se o bloco NimBLE
# for removido.
CONFIG_CELEROS_BLUETOOTH=y

# Console/celerctl na USB-Serial/JTAG nativa (o cabo rotulado "USB" do devkit).
# Logs e sessoes do celerctl se multiplexam nessa mesma porta (SerialLink).
CONFIG_CELEROS_LINK_ON_USJ=y
# O host OTG sai: sem ele a USJ existe, e o robo nao usa USB.*.
# CONFIG_CELEROS_USB_HOST is not set
